generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Category {
  id             Int        @id @default(autoincrement())
  name           String
  slug           String     @unique
  description    String?    @db.Text
  imageUrl       String?
  position       Int        @default(0)
  parentId       Int?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  imageUploadKey String?
  parent         Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children       Category[] @relation("CategoryToCategory")
  products       Product[]  @relation("ProductCategories")

  @@index([parentId])
}

model Product {
  id                Int              @id @default(autoincrement())
  name              String
  slug              String           @unique
  sku               String?
  unitLabel         String?
  price             Int
  compareAtPrice    Int?
  shortDescription  String?          @db.Text
  description       String?          @db.LongText
  usageGuide        String?          @db.Text
  preservationGuide String?          @db.Text
  isFeatured        Boolean          @default(false)
  isOnSale          Boolean          @default(false)
  isBestSeller      Boolean          @default(false)
  isNew             Boolean          @default(false)
  status            String           @default("active")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  quantity          Int              @default(0)
  images            ProductImage[]
  variants          ProductVariant[]
  categories        Category[]       @relation("ProductCategories")

  @@index([isFeatured])
  @@index([isOnSale])
  @@index([isBestSeller])
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  url       String
  alt       String?
  position  Int     @default(0)
  productId Int
  uploadKey String?
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id             Int     @id @default(autoincrement())
  name           String
  price          Int
  compareAtPrice Int?
  sku            String?
  position       Int     @default(0)
  productId      Int
  product        Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Banner {
  id                   Int      @id @default(autoincrement())
  title                String?
  subtitle             String?
  imageUrl             String
  imageMobileUrl       String?
  link                 String?
  buttonText           String?
  position             Int      @default(0)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  imageMobileUploadKey String?
  imageUploadKey       String?
}

model Post {
  id                  Int      @id @default(autoincrement())
  title               String
  slug                String   @unique
  excerpt             String?  @db.Text
  content             String   @db.LongText
  coverImageUrl       String?
  author              String?  @default("DanaFarm")
  isFeatured          Boolean  @default(false)
  publishedAt         DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  coverImageUploadKey String?

  @@index([publishedAt])
}

model Page {
  id        Int      @id @default(autoincrement())
  title     String
  slug      String   @unique
  content   String   @db.LongText
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSetting {
  id                  Int      @id @default(autoincrement())
  companyName         String   @default("CÔNG TY TNHH DANAFARM")
  taxCode             String?  @default("5801501977")
  addressBusiness     String?  @db.Text
  addressHeadquarters String?  @db.Text
  phone               String?  @default("0385250680")
  email               String?  @default("info@dalatfarm1994.com")
  logoUrl             String?
  facebookUrl         String?
  zaloUrl             String?
  messengerUrl        String?
  freeShipThreshold   Int?     @default(350000)
  updatedAt           DateTime @updatedAt
  logoUploadKey       String?
  originLat           Float?   @default(11.8203)
  originLng           Float?   @default(108.483)
  shippingBaseFee     Int      @default(20000)
  shippingBaseKm      Float    @default(10)
  shippingPerKmFee    Int      @default(3500)
  bankAccountName     String?  @default("CONG TY TNHH DANAFARM")
  bankAccountNo       String?  @default("0385250680")
  bankId              String?  @default("MB")
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  message   String   @db.Text
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())
}

model User {
  id            Int            @id @default(autoincrement())
  name          String
  email         String         @unique
  passwordHash  String
  phone         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  role          UserRole       @default(CUSTOMER)
  addresses     Address[]
  orders        Order[]
  sessions      Session[]
  voucherUsages VoucherUsage[]

  @@index([role])
}

model Address {
  id            Int      @id @default(autoincrement())
  userId        Int
  recipientName String
  phone         String
  provinceCode  String
  provinceName  String
  wardCode      String
  wardName      String
  addressLine   String   @db.Text
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  latitude      Float?
  longitude     Float?
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Voucher {
  id             Int                 @id @default(autoincrement())
  code           String              @unique
  title          String
  description    String?             @db.Text
  discountType   VoucherDiscountType @default(FIXED_AMOUNT)
  discountValue  Int
  minOrderValue  Int                 @default(0)
  maxDiscount    Int?
  usageLimit     Int?
  usedCount      Int                 @default(0)
  startsAt       DateTime
  expiresAt      DateTime
  isActive       Boolean             @default(true)
  showOnHomepage Boolean             @default(true)
  position       Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  orders         Order[]             @relation("VoucherOrders")
  usages         VoucherUsage[]

  @@index([isActive, startsAt, expiresAt])
  @@index([showOnHomepage, position])
}

model Order {
  id            Int           @id @default(autoincrement())
  code          String        @unique
  userId        Int
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod @default(COD)
  recipientName String
  phone         String
  provinceName  String
  wardName      String
  addressLine   String        @db.Text
  latitude      Float?
  longitude     Float?
  distanceKm    Float?
  note          String?       @db.Text
  subtotal      Int
  shippingFee   Int
  discount      Int           @default(0)
  total         Int
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  voucherCode   String?
  voucherId     Int?
  paidAt        DateTime?
  paymentStatus PaymentStatus @default(PENDING)
  user          User          @relation(fields: [userId], references: [id])
  voucher       Voucher?      @relation("VoucherOrders", fields: [voucherId], references: [id])
  items         OrderItem[]
  voucherUsage  VoucherUsage? @relation("OrderVoucherUsage")

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([voucherId])
}

model VoucherUsage {
  id        Int      @id @default(autoincrement())
  voucherId Int
  userId    Int
  orderId   Int      @unique
  discount  Int
  createdAt DateTime @default(now())
  order     Order    @relation("OrderVoucherUsage", fields: [orderId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
  voucher   Voucher  @relation(fields: [voucherId], references: [id])

  @@unique([voucherId, userId])
  @@index([userId])
}

model OrderItem {
  id          Int     @id @default(autoincrement())
  orderId     Int
  productId   Int
  productName String
  variantId   Int?
  variantName String?
  imageUrl    String?
  unitLabel   String?
  price       Int
  quantity    Int
  lineTotal   Int
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  userId    Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum VoucherDiscountType {
  FIXED_AMOUNT
  PERCENTAGE
  FREE_SHIPPING
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKING
  SHIPPING
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
  FAILED
}
